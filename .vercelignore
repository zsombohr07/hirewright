# Vercel builds this repo with a custom command (see vercel.json):
#   npm run build  ->  astro build && node assemble.mjs  ->  output/
# The assemble step needs the legacy homepage AND its root assets present in
# the build environment, so those are NOT ignored here.

# Never deploy / not needed at build time
node_modules/
dist/
output/

# Sales / prospecting data — never deploy (PII)
Unified list/
Input lists/
--Platforms--

# Standalone CLI tooling — not part of the site
stepstone_prospector/
tools/

# Working files / junk
index_backup.html
hirewright_homepage_spec.txt
*.textClipping
.DS_Store
