---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  path: string;
  lang?: string;
  updated: string;
}
const { title, description, path, lang = 'de', updated } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---

<BaseLayout title={title} description={description} path={path} lang={lang} locale="de_DE">
  <header class="border-b border-white/10 bg-navy">
    <div class="shell flex h-16 items-center justify-between">
      <a href={base} class="display text-xl leading-none text-paper">Hirewright</a>
      <a href={base} class="font-mono text-xs uppercase tracking-caps text-paper/70 transition-colors hover:text-amber">
        Zur Startseite
      </a>
    </div>
  </header>

  <main id="main" class="bg-paper">
    <div class="shell max-w-3xl py-16 md:py-24">
      <h1 class="display text-display-md text-navy">{title}</h1>
      <p class="mt-3 font-mono text-xs uppercase tracking-caps text-slate">
        Stand: {updated}
      </p>
      <div class="legal mt-10">
        <slot />
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  .legal h2 {
    font-family: 'Archivo Condensed', 'Arial Narrow', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: 1.375rem;
    color: #0a2540;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(13, 13, 13, 0.15);
  }
  .legal h3 {
    font-weight: 600;
    color: #0a2540;
    margin-top: 1.5rem;
    font-size: 1rem;
  }
  .legal p,
  .legal li {
    color: #6e6e73;
    line-height: 1.7;
    margin-top: 0.75rem;
    font-size: 0.95rem;
  }
  .legal ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal .ph {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    color: #0d0d0d;
    background: rgba(245, 158, 11, 0.12);
    padding: 0.05rem 0.35rem;
  }
</style>
