---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { SITE } from '../config';

export interface Props {
  title: string;
  description: string;
  /** Path of the current page, e.g. "/" or "/de/". Used for canonical + og:url. */
  path?: string;
  lang?: string;
  locale?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  path = '/',
  lang = 'en',
  locale = 'en_GB',
  ogImage,
  jsonLd = [],
  noindex = false,
} = Astro.props;

// The whole site is mounted at import.meta.env.BASE_URL (e.g. "/lander/").
// Join it onto app-absolute paths so links and assets resolve under the base.
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const withBase = (p: string) => base + p.replace(/^\//, '');

const canonical = new URL(withBase(path === '/' ? '' : path), SITE.url).href;
const homeHref = withBase('');
const deHref = withBase('de/');
const ogImageAbs = new URL(ogImage ?? withBase('og-image.jpg'), SITE.url).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0A2540" />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />
    <meta name="author" content={`${SITE.name} — ${SITE.legalEntity}`} />

    <!-- Icons -->
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <!-- Language alternates (EN now, DE at /lander/de later) -->
    <link rel="alternate" hreflang="en" href={new URL(homeHref, SITE.url).href} />
    <link rel="alternate" hreflang="de" href={new URL(deHref, SITE.url).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(homeHref, SITE.url).href} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Preload the two above-the-fold font files to avoid FOUT on the hero. -->
    <link
      rel="preload"
      href={withBase('/fonts/archivo-condensed-600-700-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase('/fonts/inter-400-500-600-latin.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      jsonLd.map((block) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(block)}
        />
      ))
    }

    <Analytics />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-navy focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:uppercase focus:tracking-caps focus:text-paper">
      Skip to content
    </a>
    <slot />
    <ConsentBanner />
  </body>
</html>
