---
import { copy } from '../content/copy.en';
const { ctaBand, cta, contact } = copy;
---

<section class="relative overflow-hidden border-y-2 border-amber bg-navy py-16 text-paper md:py-20">
  <div class="shell flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-2xl">
      <h2 class="display text-display-md text-paper">{ctaBand.h2}</h2>
      <p class="mt-4 text-lg leading-relaxed text-paper/80">{ctaBand.sub}</p>
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
      <button type="button" class="btn-amber px-8 py-4" data-open-form>{cta.request}</button>
      <a href={`tel:${contact.phone}`} class="btn-outline-invert px-8 py-4">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
        </svg>
        {cta.call}
      </a>
    </div>
  </div>
</section>
