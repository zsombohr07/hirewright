---
import { copy } from '../content/copy.en';
import { WEBHOOK_URL } from '../config';
const { form, rateCard } = copy;

const inputBase =
  'w-full border border-ink/25 bg-white px-3.5 py-3 text-[0.95rem] text-ink placeholder:text-slate/60 focus:border-amber focus-visible:outline-amber';
const labelBase = 'mb-1.5 block font-mono text-[0.6875rem] uppercase tracking-caps text-slate';
---

<section id="request" class="scroll-mt-16 bg-navy py-20 md:py-28">
  <div class="shell">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow mb-4 flex items-center gap-3 text-paper/60">
        <span class="h-px w-8 bg-amber" aria-hidden="true"></span>
        {form.label}
      </p>
      <h2 class="display text-display-md text-paper">{form.heading}</h2>
      <p class="mt-3 max-w-xl text-lg text-paper/75">{form.sub}</p>

      <!-- Work-order panel. -->
      <div class="notch relative mt-8 bg-paper">
        <form
          id="request-form"
          class="grid grid-cols-1 gap-x-6 gap-y-5 p-6 md:grid-cols-2 md:p-10"
          novalidate
        >
          <div>
            <label class={labelBase} for="field-company">
              {form.fields.company.label} <span class="text-amber" aria-hidden="true">*</span>
            </label>
            <input class={inputBase} type="text" id="field-company" name="company" required autocomplete="organization" aria-describedby="err-company" />
            <p id="err-company" class="mt-1 hidden font-mono text-xs text-ink" data-error></p>
          </div>

          <div>
            <label class={labelBase} for="field-name">
              {form.fields.contactName.label} <span class="text-amber" aria-hidden="true">*</span>
            </label>
            <input class={inputBase} type="text" id="field-name" name="contactName" required autocomplete="name" aria-describedby="err-name" />
            <p id="err-name" class="mt-1 hidden font-mono text-xs text-ink" data-error></p>
          </div>

          <div>
            <label class={labelBase} for="field-email">
              {form.fields.email.label} <span class="text-amber" aria-hidden="true">*</span>
            </label>
            <input class={inputBase} type="email" id="field-email" name="email" required autocomplete="email" aria-describedby="err-email" />
            <p id="err-email" class="mt-1 hidden font-mono text-xs text-ink" data-error></p>
          </div>

          <div>
            <label class={labelBase} for="field-phone">
              {form.fields.phone.label} <span class="text-amber" aria-hidden="true">*</span>
            </label>
            <input class={inputBase} type="tel" id="field-phone" name="phone" required autocomplete="tel" aria-describedby="err-phone" />
            <p id="err-phone" class="mt-1 hidden font-mono text-xs text-ink" data-error></p>
          </div>

          <div>
            <label class={labelBase} for="field-role">{form.fields.role.label}</label>
            <select class={`${inputBase} appearance-none`} id="field-role" name="role">
              <option value="">{form.rolePlaceholder}</option>
              {rateCard.rows.map((r) => <option value={r.id}>{r.category}</option>)}
              <option value="other">{form.roleOtherLabel}</option>
            </select>
          </div>

          <div>
            <label class={labelBase} for="field-headcount">{form.fields.headcount.label}</label>
            <input class={inputBase} type="number" min="1" inputmode="numeric" id="field-headcount" name="headcount" />
          </div>

          <div>
            <label class={labelBase} for="field-location">{form.fields.location.label}</label>
            <input class={inputBase} type="text" id="field-location" name="location" autocomplete="address-level2" />
          </div>

          <div>
            <label class={labelBase} for="field-start">{form.fields.startDate.label}</label>
            <input class={inputBase} type="date" id="field-start" name="startDate" />
          </div>

          <div class="md:col-span-2">
            <label class={labelBase} for="field-notes">{form.fields.notes.label}</label>
            <textarea class={inputBase} id="field-notes" name="notes" rows="3"></textarea>
          </div>

          <!-- Honeypot: bots fill it, humans never see it. -->
          <div class="hidden" aria-hidden="true">
            <label>Do not fill this field
              <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <div class="md:col-span-2">
            <button type="submit" class="btn-amber w-full py-4 sm:w-auto sm:px-10">
              {form.submit}
            </button>
            <p id="form-error" class="mt-3 hidden font-mono text-sm text-ink" role="alert"></p>
          </div>
        </form>

        <!-- Success state, revealed after submit. -->
        <div id="request-success" class="hidden p-8 md:p-12">
          <p class="eyebrow mb-4 flex items-center gap-3">
            <span class="h-px w-8 bg-amber" aria-hidden="true"></span>
            {form.label}
          </p>
          <p class="display text-2xl text-navy md:text-3xl">{form.success}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ WEBHOOK_URL, MESSAGES: form.validation, ERR: form.error }}>
  (function () {
    var formEl = document.getElementById('request-form');
    if (!formEl) return;
    var successEl = document.getElementById('request-success');
    var formError = document.getElementById('form-error');

    function uuid() {
      if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
      return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
        var r = (Math.random() * 16) | 0;
        var v = c === 'x' ? r : (r & 0x3) | 0x8;
        return v.toString(16);
      });
    }

    var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function setError(name, msg) {
      var input = formEl.querySelector('[name="' + name + '"]');
      var err = document.getElementById('err-' + name.replace('contactName', 'name'));
      if (!input) return;
      if (msg) {
        input.setAttribute('aria-invalid', 'true');
        input.classList.add('border-amber');
        if (err) {
          err.textContent = msg;
          err.classList.remove('hidden');
        }
      } else {
        input.removeAttribute('aria-invalid');
        input.classList.remove('border-amber');
        if (err) {
          err.textContent = '';
          err.classList.add('hidden');
        }
      }
    }

    function validate() {
      var ok = true;
      var v = {
        company: formEl.company.value.trim(),
        name: formEl.contactName.value.trim(),
        email: formEl.email.value.trim(),
        phone: formEl.phone.value.trim(),
      };
      setError('company', v.company ? '' : MESSAGES.company);
      setError('contactName', v.name ? '' : MESSAGES.contactName);
      setError('email', emailRe.test(v.email) ? '' : MESSAGES.email);
      setError('phone', v.phone ? '' : MESSAGES.phone);
      if (!v.company || !v.name || !emailRe.test(v.email) || !v.phone) ok = false;
      if (!ok) {
        var firstBad = formEl.querySelector('[aria-invalid="true"]');
        if (firstBad) firstBad.focus();
      }
      return ok;
    }

    // Clear a field's error as the user corrects it.
    ['company', 'contactName', 'email', 'phone'].forEach(function (n) {
      formEl[n] &&
        formEl[n].addEventListener('input', function () {
          setError(n, '');
        });
    });

    formEl.addEventListener('submit', function (e) {
      e.preventDefault();
      formError.classList.add('hidden');
      if (!validate()) return;
      if (formEl.company_website.value) return; // honeypot tripped

      var eventId = uuid();
      var data = {};
      new FormData(formEl).forEach(function (val, key) {
        if (key !== 'company_website') data[key] = val;
      });
      data.source = 'request-form';
      data.event_id = eventId;
      data.page = location.href;
      data.submitted_at = new Date().toISOString();

      var submitBtn = formEl.querySelector('button[type="submit"]');
      submitBtn.disabled = true;

      function onSuccess() {
        if (window.hwTrackLead) window.hwTrackLead(eventId);
        formEl.classList.add('hidden');
        successEl.classList.remove('hidden');
        successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }

      function onFail() {
        submitBtn.disabled = false;
        formError.textContent = ERR;
        formError.classList.remove('hidden');
      }

      if (!WEBHOOK_URL) {
        // No endpoint configured yet — mock a successful submission.
        setTimeout(onSuccess, 400);
        return;
      }

      fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      })
        .then(function (r) {
          if (r.ok) onSuccess();
          else onFail();
        })
        .catch(onFail);
    });
  })();
</script>
