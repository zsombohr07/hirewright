---
import FormEmbed from './FormEmbed.astro';
import { copy } from '../content/copy.en';
const { form } = copy;
---

<section id="request" class="scroll-mt-16 bg-navy py-20 md:py-28">
  <div class="shell">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow mb-4 flex items-center gap-3 text-paper/60">
        <span class="h-px w-8 bg-amber" aria-hidden="true"></span>
        {form.label}
      </p>
      <h2 class="display text-display-md text-paper">{form.heading}</h2>
      <p class="mt-3 max-w-xl text-lg text-paper/75">{form.sub}</p>

      <!-- Work-order panel holding the embedded request form. -->
      <div class="notch relative mt-8 bg-paper p-4 sm:p-6">
        <FormEmbed instanceId="inline" />
      </div>
    </div>
  </div>
</section>
