---
import { copy } from '../content/copy.en';
const { socialProof } = copy;
const items = socialProof.items;
---

<section class="border-y border-white/10 bg-navy py-8" aria-label={socialProof.eyebrow}>
  <div class="shell">
    <p class="eyebrow mb-5 text-paper/60">{socialProof.eyebrow}</p>
  </div>

  <!-- Static, wrapped list on small screens. -->
  <div class="shell flex flex-wrap items-center gap-x-6 gap-y-3 md:hidden">
    {
      items.map((item) => (
        <span class="display text-lg text-paper/80">{item}</span>
      ))
    }
  </div>

  <!-- Animated marquee on md and up. Paused on hover, static for reduced motion. -->
  <div class="marquee relative hidden overflow-hidden md:block">
    <div class="marquee-track flex w-max items-center">
      {
        [0, 1].map((seq) => (
          <div class="flex items-center" aria-hidden={seq === 1 ? 'true' : undefined}>
            {items.map((item) => (
              <span class="flex items-center">
                <span class="display px-8 text-2xl text-paper/80">{item}</span>
                <span class="h-1.5 w-1.5 shrink-0 bg-amber" aria-hidden="true" />
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
