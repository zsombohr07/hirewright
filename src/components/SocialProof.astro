---
import { copy } from '../content/copy.en';
const { socialProof } = copy;
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const withBase = (p: string) => base + p.replace(/^\//, '');
const logos = socialProof.logos;
---

<section class="border-y border-ink/10 bg-white py-10" aria-label={socialProof.eyebrow}>
  <div class="shell">
    <p class="eyebrow mb-6 text-slate">{socialProof.eyebrow}</p>
  </div>

  <!-- Static, wrapped grid on small screens. -->
  <div class="shell flex flex-wrap items-center gap-x-10 gap-y-6 md:hidden">
    {
      logos.map((logo) => (
        <img
          src={withBase(logo.file)}
          alt={logo.name}
          width="284"
          height="160"
          loading="lazy"
          class="h-12 w-auto object-contain"
        />
      ))
    }
  </div>

  <!-- Animated marquee on md and up. Paused on hover, static for reduced motion. -->
  <div class="marquee relative hidden overflow-hidden md:block">
    <div class="marquee-track flex w-max items-center">
      {
        [0, 1].map((seq) => (
          <div class="flex items-center" aria-hidden={seq === 1 ? 'true' : undefined}>
            {logos.map((logo) => (
              <img
                src={withBase(logo.file)}
                alt={seq === 1 ? '' : logo.name}
                width="284"
                height="160"
                loading="lazy"
                class="mx-10 h-14 w-auto object-contain"
              />
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
