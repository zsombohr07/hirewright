---
import { copy } from '../content/copy.en';
const { why } = copy;
---

<section id="why" class="scroll-mt-16 bg-paper py-20 md:py-28">
  <div class="shell">
    <p class="eyebrow mb-4 flex items-center gap-3">
      <span class="h-px w-8 bg-amber" aria-hidden="true"></span>
      {why.heading}
    </p>
    <h2 class="display mb-12 text-display-lg text-navy md:mb-16">{why.heading}</h2>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-8">
      <!-- Without: the dull, plain card. -->
      <div class="border border-ink/15 bg-white p-7 md:p-9">
        <p class="mb-7 flex items-center gap-3 font-mono text-xs uppercase tracking-caps text-slate">
          <svg class="h-4 w-4 text-ink/35" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="18" y1="6" x2="6" y2="18" />
          </svg>
          {why.withoutLabel}
        </p>
        <ul>
          {
            why.rows.map((row) => (
              <li class="flex items-start gap-3 border-t border-ink/10 py-4 first:border-t-0 first:pt-0">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-ink/30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <line x1="6" y1="6" x2="18" y2="18" />
                  <line x1="18" y1="6" x2="6" y2="18" />
                </svg>
                <span class="text-[0.95rem] leading-relaxed text-slate">{row.without}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- With: the navy plate, the brand surface. It wins. -->
      <div class="notch relative bg-navy p-7 text-paper md:p-9">
        <p class="mb-7 flex items-center gap-3 font-mono text-xs uppercase tracking-caps text-amber">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          {why.withLabel}
        </p>
        <ul>
          {
            why.rows.map((row) => (
              <li class="flex items-start gap-3 border-t border-white/12 py-4 first:border-t-0 first:pt-0">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-amber" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span class="text-[0.95rem] font-medium leading-relaxed text-paper/90">{row.with}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
