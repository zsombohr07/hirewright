---
import { copy } from '../content/copy.en';
const { hero, cta, contact } = copy;
---

<section class="relative overflow-hidden bg-navy text-paper">
  <!-- Faint signage grid, purely decorative. -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.04]"
    aria-hidden="true"
    style="background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:64px 64px"
  >
  </div>

  <div class="shell relative py-20 md:py-28 lg:py-32">
    <div class="max-w-4xl">
      <p class="eyebrow mb-6 flex items-center gap-3 text-amber">
        <span class="h-2 w-2 bg-amber" aria-hidden="true"></span>
        {hero.eyebrow}
      </p>

      <h1 class="display text-display-xl text-paper">
        {hero.h1}
      </h1>

      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-paper/85 md:text-xl">
        {hero.sub}
      </p>

      <p class="mt-5 font-mono text-sm leading-relaxed text-paper/60">
        {hero.support}
      </p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <button type="button" class="btn-amber" data-open-form>{cta.request}</button>
        <a href={`tel:${contact.phone}`} class="btn-outline-invert">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          {cta.call}
        </a>
      </div>
    </div>
  </div>
</section>
