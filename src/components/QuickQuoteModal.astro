---
import { copy } from '../content/copy.en';
import { WEBHOOK_URL } from '../config';
const { quickQuote } = copy;

const inputBase =
  'w-full border border-ink/25 bg-white px-3.5 py-3 text-[0.95rem] text-ink placeholder:text-slate/60 focus:border-amber focus-visible:outline-amber';
const labelBase = 'mb-1.5 block font-mono text-[0.6875rem] uppercase tracking-caps text-slate';
---

<dialog id="quote-modal" class="w-[min(92vw,30rem)] border-0 bg-transparent p-0 backdrop:bg-navy/70">
  <div class="notch relative bg-paper">
    <div class="flex items-start justify-between border-b border-ink/15 px-6 pt-6">
      <div class="pb-4">
        <p class="eyebrow mb-2">{quickQuote.heading}</p>
        <p class="text-sm leading-relaxed text-slate">{quickQuote.sub}</p>
      </div>
      <button
        type="button"
        data-close-quote
        class="-mr-1 -mt-1 p-2 text-slate hover:text-ink"
        aria-label={quickQuote.close}
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="5" y1="5" x2="19" y2="19"></line>
          <line x1="19" y1="5" x2="5" y2="19"></line>
        </svg>
      </button>
    </div>

    <form id="quote-form" class="flex flex-col gap-4 p-6" novalidate>
      <div>
        <label class={labelBase} for="q-email">{quickQuote.fields.email.label}</label>
        <input class={inputBase} type="email" id="q-email" name="email" required autocomplete="email" aria-describedby="q-err" />
      </div>
      <div>
        <label class={labelBase} for="q-roles">{quickQuote.fields.roles.label}</label>
        <input class={inputBase} type="text" id="q-roles" name="roles" required />
      </div>
      <div>
        <label class={labelBase} for="q-headcount">{quickQuote.fields.headcount.label}</label>
        <input class={inputBase} type="number" min="1" inputmode="numeric" id="q-headcount" name="headcount" />
      </div>
      <p id="q-err" class="hidden font-mono text-xs text-ink" role="alert"></p>
      <button type="submit" class="btn-amber w-full py-3.5">{quickQuote.submit}</button>
    </form>

    <div id="quote-success" class="hidden p-8">
      <p class="eyebrow mb-3 flex items-center gap-3">
        <span class="h-px w-8 bg-amber" aria-hidden="true"></span>
        {quickQuote.heading}
      </p>
      <p class="display text-xl text-navy">{quickQuote.success}</p>
      <button type="button" data-close-quote class="btn-outline mt-6 py-2.5">{quickQuote.close}</button>
    </div>
  </div>
</dialog>

<script is:inline define:vars={{ WEBHOOK_URL, EMAIL_ERR: quickQuote.fields.email.label, ROLES: quickQuote.fields.roles.label }}>
  (function () {
    var modal = document.getElementById('quote-modal');
    if (!modal || !modal.showModal) return;
    var formEl = document.getElementById('quote-form');
    var successEl = document.getElementById('quote-success');
    var errEl = document.getElementById('q-err');
    var emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function uuid() {
      if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
      return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
        var r = (Math.random() * 16) | 0;
        var v = c === 'x' ? r : (r & 0x3) | 0x8;
        return v.toString(16);
      });
    }

    function open() {
      formEl.classList.remove('hidden');
      successEl.classList.add('hidden');
      errEl.classList.add('hidden');
      modal.showModal();
      var first = document.getElementById('q-email');
      if (first) first.focus();
    }
    function close() {
      modal.close();
    }

    document.querySelectorAll('[data-open-quote]').forEach(function (b) {
      b.addEventListener('click', open);
    });
    modal.querySelectorAll('[data-close-quote]').forEach(function (b) {
      b.addEventListener('click', close);
    });
    // Click on the backdrop closes.
    modal.addEventListener('click', function (e) {
      if (e.target === modal) close();
    });

    formEl.addEventListener('submit', function (e) {
      e.preventDefault();
      errEl.classList.add('hidden');
      var email = formEl.email.value.trim();
      var roles = formEl.roles.value.trim();
      if (!emailRe.test(email) || !roles) {
        errEl.textContent = 'Enter a valid work email and the roles you need.';
        errEl.classList.remove('hidden');
        return;
      }

      var eventId = uuid();
      var data = {
        email: email,
        roles: roles,
        headcount: formEl.headcount.value,
        source: 'quick-quote',
        event_id: eventId,
        page: location.href,
        submitted_at: new Date().toISOString(),
      };

      var btn = formEl.querySelector('button[type="submit"]');
      btn.disabled = true;

      function onSuccess() {
        if (window.hwTrackLead) window.hwTrackLead(eventId);
        formEl.classList.add('hidden');
        successEl.classList.remove('hidden');
      }
      function onFail() {
        btn.disabled = false;
        errEl.textContent = 'Something went wrong. Please try again.';
        errEl.classList.remove('hidden');
      }

      if (!WEBHOOK_URL) {
        setTimeout(onSuccess, 400);
        return;
      }
      fetch(WEBHOOK_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      })
        .then(function (r) {
          if (r.ok) onSuccess();
          else onFail();
        })
        .catch(onFail);
    });
  })();
</script>
