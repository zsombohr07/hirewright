---
import { copy } from '../content/copy.en';
const { rateCard } = copy;
---

<section id="rate-card" class="scroll-mt-16 bg-paper py-20 md:py-28">
  <div class="shell">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow mb-4 flex items-center gap-3">
        <span class="h-px w-8 bg-amber" aria-hidden="true"></span>
        {rateCard.heading}
      </p>

      <!-- The nameplate: a document printed and pinned to a wall. -->
      <div class="notch relative bg-navy text-paper shadow-[0_1px_0_0_rgba(10,37,64,0.9)]">
        <div class="px-6 pt-6 md:px-10 md:pt-8">
          <p class="font-mono text-[0.625rem] uppercase tracking-[0.2em] text-amber md:text-xs">
            {rateCard.label}
          </p>
          <div class="mt-4 rule-navy"></div>
        </div>

        <h2 class="sr-only">{rateCard.heading}</h2>
        <ul class="px-6 pb-8 md:px-10">
          {
            rateCard.rows.map((row) => (
              <li>
                <a
                  href="#request"
                  data-role={row.id}
                  class="group flex items-start gap-4 border-b border-white/12 py-5 transition-colors last:border-b-0 hover:bg-white/[0.04]"
                >
                  <div class="min-w-0 flex-1">
                    <h3 class="display text-lg leading-tight text-paper transition-colors group-hover:text-amber md:text-xl">
                      {row.category}
                    </h3>
                    <p class="mt-1.5 text-sm leading-relaxed text-paper/55">
                      {row.description}
                    </p>
                  </div>
                  <div class="shrink-0 pt-0.5 text-right font-mono [font-variant-numeric:tabular-nums]">
                    <span class="text-xl font-medium text-paper md:text-2xl">
                      &euro;{row.rate}
                    </span>
                    <span class="text-sm text-paper/55">{row.rateUnit}</span>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="mt-5 max-w-xl text-sm leading-relaxed text-slate">
        {rateCard.finePrint}
      </p>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll('a[data-role]').forEach(function (a) {
      a.addEventListener('click', function () {
        var role = a.getAttribute('data-role');
        var select = document.getElementById('field-role');
        if (select) {
          select.value = role;
          select.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
    });
  })();
</script>
